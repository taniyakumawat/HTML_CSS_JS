# ===== Server configuration =====
# Port the Express API listens on
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/college_attendance

# JWT signing secret - use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Allowed frontend origin (CORS). Always allowed in addition to this value:
# https://attendance-client.vercel.app (production frontend) and
# http://localhost:5173 (local dev). Trailing slashes are ignored.
CLIENT_URL=http://localhost:5173

# Optional: an extra allowed CORS origin (e.g. a second frontend deploy)
# FRONTEND_URL=https://another-frontend.vercel.app

# Phase 9: set true when running behind a reverse proxy (nginx) so
# rate-limiting sees the real client IP from X-Forwarded-For
TRUST_PROXY=false

# Phase 9: failed-login budget per IP per 15 minutes (brute-force guard)
LOGIN_RATE_LIMIT=20

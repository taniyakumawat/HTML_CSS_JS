# ===== Frontend configuration =====
# Base URL for every API request (axios instance in src/api/client.js).
# The '/api' suffix is appended automatically when missing, so both forms
# below are valid - never a trailing slash and never '/api/api'.
#
# Production (Vercel) - the deployed Express API server:
VITE_API_BASE_URL=https://server-taniya16.vercel.app
#
# Local development - use '/api' instead; the Vite dev server proxies
# /api to http://localhost:5000 (see vite.config.js):
# VITE_API_BASE_URL=/api
